{
  "name": "mcu-all-in-one-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "check": "node --check src/app.js && node --check src/server.js",
    "migrate:json-to-mysql": "node --env-file=.env database/migrate-json-to-mysql.js"
  },
  "dependencies": {
    "@azure/msal-node": "^5.0.6",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.4",
    "swagger-ui-express": "^5.0.1"
  }
}
