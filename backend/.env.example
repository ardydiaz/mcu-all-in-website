PORT=3005
NODE_ENV=development
CLIENT_URL=http://localhost:5002
JWT_SECRET=generate-a-long-random-production-secret

DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mcu_app
DB_PASSWORD=replace-with-database-password
DB_NAME=mcu_all_in_one

MS_TENANT_ID=your-microsoft-entra-tenant-id
MS_CLIENT_ID=your-microsoft-entra-application-client-id
MS_CLIENT_SECRET=your-microsoft-entra-client-secret
MS_REDIRECT_URI=http://localhost:3005/api/auth/microsoft/callback
MICROSOFT_DEFAULT_ROLE_ID=4

# Local/Postman testing only; disabled when NODE_ENV=production
API_TEST_USERNAME=api.admin
API_TEST_PASSWORD=replace-with-a-local-testing-password
API_TEST_EMAIL=api.admin@mcu.edu.ph
## Authentication protection (optional; defaults shown)
AUTH_RATE_LIMIT_WINDOW_MS=900000
MICROSOFT_LOGIN_RATE_LIMIT=20
LOCAL_LOGIN_RATE_LIMIT=5
